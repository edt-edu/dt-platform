{
  "name": "@mbdo/machines-svg-map",
  "version": "1.0.1",
  "description": "A SVG map for FischerTechnik Factory Machines configuration",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "scripts": {
    "prepublish": "tsc",
    "build:ts": "tsc -p .",
    "watch": "tsc -w -p .",
    "generate": "node ./dist/cli.js ./resources/machine_config.json dist/machine_config.svg  --addPositions --addDimensions --accessibleZoneOpacity 0.5",
    "watch:generate": "onchange 'src/**/*.ts' '**/*_config.json' -- sh -c 'npm run build:ts && npm run generate' --verbose",
    "test": "npx tsx --test test/golden.test.ts",
    "test:update-golden": "rm -f test/__snapshots__/machine_config.golden.svg && npm test"
  },
  "author": "Didier Vojtisek",
  "license": "EPL-2.0",
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/snapsvg": "^0.5.8",
    "@types/svgdom": "^0.1.2",
    "onchange": "^7.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "type": "module",
  "dependencies": {
    "@svgdotjs/svg.js": "^3.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "commander": "^14.0.3",
    "reflect-metadata": "^0.2.2",
    "snapsvg": "^0.5.1",
    "svgdom": "^0.1.19",
    "xml-formatter": "^3.6.2"
  }
}
