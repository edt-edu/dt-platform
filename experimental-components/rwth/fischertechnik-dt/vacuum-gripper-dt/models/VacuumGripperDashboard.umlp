import java.time.LocalDate;

umlp VacuumGripperDashboard{
  <<singleton>>
  class App {
    void emptyFunc();
    -> (vacuumGripperSimulation) FFunction [0..1];
    -> (simulationInput) VacuumGripperInput [0..1];
    -> (simulationOutput) VacuumGripperOutput [0..1];
    -> (physicalTwinInput) VacuumGripperInput [0..1];
    -> (physicalTwinOutput) VacuumGripperOutput [0..1];
    IntegerValue payloadPosition;
    // TODO: position for sim and pt
  }

  class VacuumGripperInput {
    BooleanValue verticalUp;
    BooleanValue verticalDown;
    BooleanValue horizontalForward;
    BooleanValue horizontalBack;
    BooleanValue rotationClockwise;
    BooleanValue rotationCounterclockwise;
  }

  class VacuumGripperOutput {
    FloatValue positionRotate;
    FloatValue positionHorizontal;
    FloatValue positionVertical;

    / boolean inLoadingZone;
    / boolean inDropoffZone;
  }

  class SimulatorStep {

  }


  // ##########################################################
  // Function Structure Model
  // ##########################################################
  // TODO: import, dont copy-past
    class FFunction {
      String name;
    }

    class Channel;

    /**
     Since Fenix currently does not support qualified associations, we emulate them using the `Port`
     class:
     For each qualifier from `Function` to a Channel in the original model, here the `Function`
     contains an instance of port, which contains the relevant name qualifing the channel from the
     function.

     We adapted `Function` with the handwritten methods `String getInChannel(String name)` and
     `String getOutChannel(String name)`, such that it can be used as if the associations are
     qualified.
    */
    class Port {
      String name;
    }

    association [0..1] FFunction (ownerIn) -> (in) Port [*];
    association [0..1] FFunction (ownerOut) -> (out) Port [*];
    association [*] Port <-> Channel [1];

    association [*] Channel -> Category [1];
    composition [0..1] FFunction (owner) <-> (subFunction) FFunction [*];

    class FunctionStream;

    association [*] FunctionStream -> Category [1];
    association [0..1] Channel <-> FunctionStream [0..1];
    composition [0..1] FFunction -> (state) FunctionStream [0..1];

    class Category {
      Optional<Boolean> continuous; // a false value stands for a discrete category
      -> Kind [0..1];
      -> Type [1];
    }

    /**
     The `Kind` class is refined by adding subclasses for the three main categories.
     Also the attribute `specifier` is added as a flexible mechanism to distinguish different finer
     kinds, without having to add additional subclasses.
     As an example, a channel might expect a fluid, but can only handle water and not oil.
     The kind would then be modeled as `water:Material { specifier = "water" }`.
     If a channel can process all fluids, the corresponding kind would be
     `fluid:Fluid { specifier = empty }`.
    */
    class Kind{
      Optional<String> specifier;
    }

    class Energy extends Kind;
    class Material extends Kind;
    class Data extends Kind;

    /**
     The underspecified `Type` of the original model is refined by adding the attribute `mctype`,
     which contains the serialized String of MontiCores SymTypeExpression of the type.
     Internally, Fenix can then use MontiCores type check to ensure types are compatible.
     */
    class Type {
      String mctype;
    }

    class Observation {
      LocalDate start;
      LocalDate end;
    }

    association [*] Observation <-> FunctionStream [1];
    association [*] Observation -> Category [1];

    /**
     Value is refined by adding subclasses for all concrete values we want to save in the database.
     If simple sensor values are observed on a channel, the system chooses exactly one subclass to
     save them, as prescribed by the category.
     IntegerValue can be used to save values without decimal places and DoubleValue for values
     with decimal places.
     If complex objects flow on a channel, the corresponding class should be defined in the class
     diagram, and a GemValue will save a reference by gemId to the object.

     // TODO: Discuss: The GemValue forces the user to define new classes.
     In other places we explicitly used Strings for extendability (Type, Kind), such that no new
     classes are needed. A consistent approach to extension would be nice.
     Alterantive: use a generic datastructure to represent the objects instead.
     The meta model of the objectdiagram language could be used.
     */
    class Value;

    class BooleanValue extends Value {
      boolean content;
    }

    class IntegerValue extends Value {
      int content;
    }

    class DoubleValue extends Value {
      double content;
    }

    class FloatValue extends Value {
      float content;
    }

    class StringValue extends Value {
      String content;
    }

    class GemValue extends Value {
      long content;
    }

    association [0..1] FunctionStream -> Value [*] {ordered};
    association [*] Observation -> Value [*] {ordered};
}