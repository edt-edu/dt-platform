package gui;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemCheckBoxInput;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import gui.VacuumGripperDisplay;
import gui.visualization.VacuumGripperSvg;
import gui.visualization.InputCard;
import gui.visualization.OutputCard;
import gui.visualization.PayloadPositionLabel;

import VacuumGripperDashboard.App;
import VacuumGripperDashboard.VacuumGripperInput;
import VacuumGripperDashboard.VacuumGripperOutput;

page SimulatorOverview(App app){
  @GemColumn(components=[
    @GemCard(title="Physical twin", component=
      @VacuumGripperDisplay(input=app.physicalTwinInput, output=app.physicalTwinOutput, payloadPosition=app.payloadPosition)
    ),
    @GemCard(title="Simulator", component=@GemRow(components=[
      @VacuumGripperDisplay(input=app.simulationInput, output=app.simulationOutput, payloadPosition=app.payloadPosition),
      @GemCard(title="Control", component=
            @GemColumn(rowGap="4px", components=[
                      simulatorStepBtn@GemButton(label = "Step", leftClick = app.emptyFunc()),
                      simulatorStopBtn@GemButton(label = "Stop", leftClick = app.emptyFunc()),
                      simulatorStartBtn@GemButton(label = "Start", leftClick = app.emptyFunc())
                    ])
      )
    ])
  )
  ]);
}