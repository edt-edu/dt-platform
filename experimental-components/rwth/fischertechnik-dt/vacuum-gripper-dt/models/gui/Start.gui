package gui;

import mc.fenix.basic.GemText;
import mc.fenix.navigation.GemNavItem;
import gui.visualization.VacuumGripperSvg;

import VacuumGripperDashboard.FFunction;
import VacuumGripperDashboard.App;


page Start(List<FFunction> functions){
  @GemNavItem(title = "Simulator", target="/gui/SimulatorOverview");

  @GemText(value = "Functions");
  @iterate(FFunction f : functions){
    funcNavItem@GemNavItem(title = f.name, target=null /*hwc*/);
  }
}