import java.time.LocalDateTime;

umlp FischertechnikVisualization {
  <<singleton>>
  class App {
    -> DoubleTopic [*];
    -> BooleanTopic [*];
  }

  class SomeClass {
    String someAttribute;
  }

  class DoubleTopic {
    String topicName;
    List<DoubleValue> values;
  }

  class BooleanTopic {
    String topicName;
    List<BooleanValue> values;
  }

  class BooleanValue {
    LocalDateTime timestamp;
    boolean content;
  }

  class DoubleValue {
    LocalDateTime timestamp;
    double content;
  }

  class Statechart {
    String name;
    List<State> states;
    List<Transition> transitions;
  }

  class State {
    String label;
    boolean initialState;
    boolean finalState;
    Optional<String> color;
  }

  class Transition {
    State source;
    State target;
    Optional<String> label;
    Optional<String> color;
  }
}